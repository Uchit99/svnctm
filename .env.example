# Database
DATABASE_URL="postgresql://user:password@localhost:5432/svnctm"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Optional - for transactional emails)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="noreply@svnctm.com"

# Shipping Provider (Optional)
SHIPPING_PROVIDER_API_KEY="your_shipping_api_key"
SHIPPING_PROVIDER_SECRET="your_shipping_secret"

# SMS Provider (Optional)
SMS_API_KEY="your_sms_api_key"

# WhatsApp (Optional)
WHATSAPP_API_KEY="your_whatsapp_api_key"

# Optional administrator credentials. Keep these private and set both values to enable admin sign-in.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="use-a-long-unique-password"
